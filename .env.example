# KIO 運用の環境変数 — 雛形 (このファイルはコミットされる。実値は書かない)
#
# 使い方:
#   cp .env.example .env   # 済みなら不要 (このリポジトリには空の .env を同梱済み)
#   chmod 600 .env
#   .env に実値を記入する (git 管理外 — .gitignore 済み)
#
# 読み込み方:
#   - KIO CLI 自体は dotenv を読まない (プロセス環境変数のみ)。シェルから使うときは:
#       set -a; source .env; set +a
#   - セッション同梱の運用ドライバ (ocr_batch_driver.py など) はリポジトリ直下の
#     .env を自動で読み込む (既に環境にある変数は上書きしない)。
#   - eval 系ハーネス (eval_env.py / register_fixture) は分離設計のため
#     資格情報を意図的に剥がす — .env を置いても合成環境へは漏れない。

# ============================================================
# 必須 (online 実行時)
# ============================================================

# Mistral — OCR 強化パス (Batch レーン固定、07 §5.7。Batch 単価 $2 / 1,000 pages)
# 2026-07-23 裁定: OCR 課金は Batch 実行のみ許可
MISTRAL_API_KEY=

# Google Gemini — embedding (gemini-embedding-2 / 768 次元 MRL / multimodal profile、
# sync 呼出 — 07 §5.3。目安 10 万 chunk ≈ $10)
GEMINI_API_KEY=

# ============================================================
# 任意 (必要になったときだけ有効化)
# ============================================================

# Mistral の workspace/account 安定識別子の上書き (07 §5.7 条件 5)。
# 未設定なら "mistral:default"。実 API 契約試験ラウンドで実値に置換予定 (backlog 1-A3 #1)
#KIO_MISTRAL_WORKSPACE_ID=

# Mistral API base URL の上書き (tools.toml の宣言 adapter が無いときのみ参照)
#MISTRAL_API_BASE=https://api.mistral.ai

# LibreOffice 変換器の明示パス (未設定なら PATH 上の soffice を解決 — 07 §5.1)
#KIO_OFFICE_CONVERTER=/opt/homebrew/bin/soffice

# ============================================================
# 書いてはいけないもの
# ============================================================
# - KIO_TEST_* (テスト seam 全般): ambient に漏れると本番のレーン選択・アダプタ解決を
#   乗っ取る (例: KIO_TEST_MISTRAL_BATCH は Batch client を mock に差し替える)。
#   テストは per-Command で自分の seam を設定する — .env に置く用途は存在しない。
# - 他ワークストリームの資格情報 (Z.AI 等): この .env は KIO 実行専用。
